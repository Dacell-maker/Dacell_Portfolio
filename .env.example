# ---------------------------------------------------------------------------
# SERVER / API  (set these in Vercel -> Project -> Settings -> Environment Variables)
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string.
# Atlas -> Database -> Connect -> Drivers -> copy the string, replace <password>.
# Make sure 0.0.0.0/0 (or Vercel's IPs) is allowed in Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# Long random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# One-time secret used by POST /api/admin/setup to create the FIRST admin user.
# After the admin exists this token is no longer needed (the endpoint refuses to run twice).
SETUP_TOKEN=change-me-too

# Vercel Blob read/write token -> https://vercel.com/<you>/<project>/stores
# Needed for image uploads from the admin dashboard.
BLOB_READ_WRITE_TOKEN=

# Port the local Express API listens on during development.
API_PORT=8787

# ---------------------------------------------------------------------------
# CLIENT  (prefixed with VITE_ so the browser can see them - never put secrets here)
# ---------------------------------------------------------------------------

# Formspree form endpoint id, e.g. https://formspree.io/f/xxxxxxxx -> VITE_FORMSPREE_ID=xxxxxxxx
VITE_FORMSPREE_ID=

# Fallback used when the API/database is not configured yet, so the public site
# still renders. Set to "false" once MongoDB is live.
VITE_USE_SEED_FALLBACK=true
